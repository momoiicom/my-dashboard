generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  googleVerifiedEmail String?
  boardGrants BoardGrant[]
  cardLayouts CardLayout[]
  appearances ViewerAppearance[]
  uploadedAppearanceAssets ImageAsset[]
  accounts      Account[]
  sessions      Session[]
  boards        Board[]
  cards         DashboardCard[]
  botToken      BotToken?
  pushSubscriptions PushSubscription[]
  @@index([googleVerifiedEmail])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id              String @id
  ownerId         String
  name            String
  nameKey         String
  originalOwnerId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cards           DashboardCard[]
  grants BoardGrant[]
  layouts CardLayout[]
  appearanceKind String @default("default")
  appearanceColor String?
  appearanceAssetId String?
  appearanceAccent String @default("#0c66e4")
  appearanceMainToolbar String?
  appearanceBoardToolbar String?
  appearanceCard String?
  appearanceButton String?
  appearanceRevision Int @default(0)
  appearanceAsset ImageAsset? @relation("AuthorAppearance", fields: [appearanceAssetId], references: [id], onDelete: NoAction)
  appearances ViewerAppearance[]
  appearanceAssets ImageAsset[] @relation("BoardAppearanceAssets")

  @@unique([ownerId, id])
  @@unique([ownerId, nameKey])
}

model DashboardCard {
  id        String   @id @default(cuid())
  ownerId   String
  boardId   String
  membershipRevision Int @default(0)
  lastMoveSourceBoardId String?
  title     String
  externalKey String?
  payload String?
  acceptedAt DateTime?
  contentRevision Int @default(0)
  kind      CardKind @default(blank)
  x         Int
  y         Int
  width     Int
  height    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  layouts CardLayout[]
  board     Board @relation(fields: [ownerId, boardId], references: [ownerId, id], onDelete: Cascade)

  @@index([ownerId, boardId])
  @@unique([ownerId, externalKey])
}

enum CardKind {
  blank
  notes
  tasks
  links
}

model BotToken {
  ownerId String @id
  tokenHash String @unique
  encryptedToken String
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model BoardGrant {
  id String @id @default(cuid())
  boardId String
  email String
  userId String?
  createdAt DateTime @default(now())
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([boardId, email])
  @@unique([boardId, userId])
  @@index([email])
  @@index([userId, createdAt, id])
}

model CardLayout {
  userId String
  boardId String
  cardId String
  x Int
  y Int
  width Int
  height Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card DashboardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@id([userId, boardId, cardId])
  @@index([cardId])
  @@index([boardId])
}

model ViewerAppearance {
  boardId String
  userId String
  backgroundKind String?
  backgroundColor String?
  backgroundAssetId String?
  accent String?
  mainToolbar String?
  boardToolbar String?
  card String?
  button String?
  revision Int @default(0)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  backgroundAsset ImageAsset? @relation("PersonalAppearance", fields: [backgroundAssetId], references: [id], onDelete: NoAction)
  @@id([boardId, userId])
}

model ImageAsset {
  id String @id
  boardId String
  uploaderId String
  scope String
  byteSize Int
  width Int
  height Int
  createdAt DateTime @default(now())
  board Board @relation("BoardAppearanceAssets", fields: [boardId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  authorReferences Board[] @relation("AuthorAppearance")
  personalReferences ViewerAppearance[] @relation("PersonalAppearance")
  @@index([boardId])
  @@index([createdAt])
}

model PushSubscription {
  id String @id @default(cuid())
  ownerId String
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
